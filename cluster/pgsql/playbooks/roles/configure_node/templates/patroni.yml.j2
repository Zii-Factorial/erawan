scope: {{ patroni_scope }}
namespace: {{ patroni_namespace }}
name: {{ erawan_pg_node_name }}

restapi:
  listen: {{ ansible_host }}:{{ patroni_rest_port }}
  connect_address: {{ ansible_host }}:{{ patroni_rest_port }}

{% if erawan_dcs_control_plane | bool %}
{# Shared control-plane DCS. etcd3 (not etcd) because the control plane runs
   the v3 API with RBAC: the v2 endpoints this file uses in the classic layout
   do not carry v3 auth, and the tenant's role/user/keys are all v3 objects.
   The node holds only the CA and its own tenant credential — no client
   certificate, no root access, and no reach outside <namespace>/<scope>/. #}
etcd3:
  hosts:
    - {{ control_plane_ip }}:{{ control_plane_etcd_client_port }}
  protocol: https
  cacert: {{ patroni_etcd_ca_path }}
{% if (patroni_etcd_client_cert_path | default('')) | length > 0 %}
{# Required when the control plane runs client-cert-auth: without a client
   certificate it aborts the TLS handshake ("certificate required") before any
   credential is exchanged. The pair is this tenant's own, minted from the
   control plane's CA with CN = the tenant's etcd user. #}
  cert: {{ patroni_etcd_client_cert_path }}
  key: {{ patroni_etcd_client_key_path }}
{% endif %}
  username: {{ control_plane_etcd_user }}
  password: {{ control_plane_etcd_password | to_json }}
{% else %}
etcd:
  hosts:
{% for host_name in groups['all'] %}
    - {{ hostvars[host_name].ansible_host }}:{{ etcd_client_port }}
{% endfor %}
{% endif %}

bootstrap:
  dcs:
    ttl: 30
    # Patroni's internal HA loop only re-evaluates/reports state on this
    # cadence — a new member's /replica endpoint won't flip to 200 until the
    # next tick after pg_basebackup actually finishes, so this is the single
    # biggest lever for add-member latency on small datasets. ttl is left
    # alone: unlike loop_wait, a too-short ttl risks false-positive failover
    # on a transient network blip, which loop_wait doesn't.
    loop_wait: 2
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    synchronous_mode_strict: false
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
{# Patroni validates max_connections with IntValidator(min=25) and silently
   ignores lower values, so only seed values it will actually accept. #}
{% if (postgres_max_connections | default(0) | int) >= 25 %}
        max_connections: {{ postgres_max_connections | int }}
{% endif %}
        shared_buffers: '{{ erawan_pg_shared_buffers_mb }}MB'
        effective_cache_size: '{{ erawan_pg_effective_cache_size_mb }}MB'
        maintenance_work_mem: '{{ erawan_pg_maintenance_work_mem_mb }}MB'
        work_mem: '{{ erawan_pg_work_mem_mb }}MB'
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        wal_log_hints: "on"
        password_encryption: scram-sha-256
        random_page_cost: 1.1
        effective_io_concurrency: 200
        bgwriter_lru_maxpages: 200
        bgwriter_lru_multiplier: 4.0
        bgwriter_delay: '100ms'
        shared_preload_libraries: 'pg_stat_statements'
        'pg_stat_statements.max': 10000
        'pg_stat_statements.track': all
        track_io_timing: "on"
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - local all postgres peer
    - local all all peer
    - local replication all peer
{# Patroni's own heartbeat connection (get_postgresql_status, used to query
   its local Postgres for WAL/LSN before it will proceed with leader
   election) connects over TCP to 127.0.0.1, not the Unix socket — the
   "local" peer entries above don't cover it. Loopback is inherently
   unreachable from any other host, so this doesn't reopen any of the
   network-facing access closed elsewhere in this file. #}
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all ::1/128 scram-sha-256
{% if (new_user | default('')) | length > 0 %}
{% if new_user_ssl_required | default(true) | bool %}
    - hostssl all {{ new_user }} {{ proxy_allowed_ip }}/32 scram-sha-256
    - hostnossl all {{ new_user }} {{ proxy_allowed_ip }}/32 reject
{% else %}
    - host all {{ new_user }} {{ proxy_allowed_ip }}/32 scram-sha-256
{% endif %}
{% endif %}
{# replication is a distinct pseudo-database in pg_hba — a "database: all"
   entry below does not implicitly match it, so it needs its own peer-scoped
   entries. Streaming replication is always node-to-node, never via the proxy. #}
{% for host_name in groups['all'] %}
    - host replication {{ replication_user }} {{ hostvars[host_name].ansible_host }}/32 scram-sha-256
{% endfor %}
{# Catch-all for postgres_superuser/patroni_admin/generic access — scoped to
   cluster peers plus the proxy/control-plane node, never the whole internet.
   The proxy IP is included because the erawan control plane (same machine as
   the proxy) manages users/databases over postgres-superuser connections —
   the app-user entries above don't cover those. The app user's stricter
   hostnossl-reject pair still wins for that user: pg_hba is first-match.
   No IPv6 rule: nothing in this deployment uses IPv6. #}
{% for host_name in groups['all'] %}
    - host all all {{ hostvars[host_name].ansible_host }}/32 scram-sha-256
{% endfor %}
    - host all all {{ proxy_allowed_ip }}/32 scram-sha-256
  users:
    {{ patroni_admin_user }}:
      password: {{ patroni_admin_password | to_json }}
      options:
        - createrole
        - createdb

postgresql:
  listen: 0.0.0.0:{{ postgres_port }}
  connect_address: {{ ansible_host }}:{{ postgres_port }}
  data_dir: {{ erawan_pg_data_directory }}
  bin_dir: {{ erawan_pg_bindir }}
  pgpass: {{ patroni_pgpass_path }}
  # Without this, pg_basebackup runs with its default --checkpoint=spread and
  # the FIRST replica clone after a bootstrap waits ~1.5-2min for the leader's
  # paced checkpoint (measured: member 1 add = 2m17s of which ~98s was
  # "creating replica"; member 2 = 35s because the checkpoint had already
  # happened). fast forces an immediate checkpoint so every clone starts now.
  basebackup:
    checkpoint: 'fast'
  authentication:
    replication:
      username: {{ replication_user }}
      password: {{ replication_password | to_json }}
    superuser:
      username: {{ postgres_superuser }}
      password: {{ postgres_superuser_password | to_json }}
  parameters:
    ssl: "on"
    ssl_cert_file: '{{ patroni_ssl_cert_file }}'
    ssl_key_file: '{{ patroni_ssl_key_file }}'
    unix_socket_directories: '/var/run/postgresql'
  remove_data_directory_on_rewind_failure: {{ patroni_remove_data_on_rewind_failure | bool }}
  remove_data_directory_on_diverged_timelines: {{ patroni_remove_data_on_diverged_timelines | bool }}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
